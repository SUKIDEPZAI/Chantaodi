# OpenAI-compatible provider (the original project used MotAPI)
MOTAPIS_API_KEY=
MOTAPIS_BASE_URL=https://motapis.com/v1
# Optional alternative. OPENAI_API_KEY takes precedence when set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-6-astra
# Optional search providers; the app still tries no-key public sources without these.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional access gate. Set a long random password for a public deployment.
APP_PASSWORD=
# Persistence. For Render, mount a persistent disk at /var/data.
DATABASE_PATH=data/chantaodi.sqlite3
WORKSPACE_DIR=data/workspace
MAX_UPLOAD_MB=20
WORKSPACE_MAX_MB=300
SEARCH_TIMEOUT_SECONDS=8
AI_TIMEOUT_SECONDS=150
AI_MAX_TOKENS=4096
LOG_LEVEL=INFO
